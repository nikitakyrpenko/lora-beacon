{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "STM32: build (anchor-blackpill)",
      "type": "shell",
      "command": "cmake --preset Release -DBRINGUP_MODE=0 -DDEBUG_ANCHOR=ON -DANCHOR_ADDRESS=0x00000A19 -DANCHOR_X_CM=100 -DANCHOR_Y_CM=-50 -DANCHOR_Z_CM=150 && cmake --build --preset Release",
      "options": {
        "cwd": "${workspaceFolder}/anchor-blackpill"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "STM32: build (beacon-blackpill)",
      "type": "shell",
      "command": "cmake --preset Release -DBRINGUP_MODE=0 -DDEBUG_BEACON=ON && cmake --build --preset Release",
      "options": {
        "cwd": "${workspaceFolder}/beacon-blackpill"
      },
      "group": "build",
      "problemMatcher": [
        "$gcc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "STM32: clean build directory (anchor-blackpill)",
      "type": "shell",
      "command": "rm -rf build",
      "options": {
        "cwd": "${workspaceFolder}/anchor-blackpill"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    },
    {
      "label": "STM32: clean build directory (beacon-blackpill)",
      "type": "shell",
